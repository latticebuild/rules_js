load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lib",
    testonly = True,
    srcs = [
        "coverage.go",
    ],
    importpath = "github.com/latticebuild/rules_js/go/lcov",
    target_compatible_with = [],
    visibility = ["//visibility:public"],
    deps = ["//go/filetree:lib"],
)

go_test(
    name = "unit_test",
    srcs = [
        "coverage_test.go",
    ],
    embed = [":lib"],
    pure = "on",
    race = "off",
    target_compatible_with = [],
)

go_test(
    name = "unit_race_test",
    srcs = [
        "coverage_test.go",
    ],
    embed = [":lib"],
    pure = "off",
    race = "on",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

test_suite(
    name = "runtime_test",
    tests = [
        ":unit_race_test",
        ":unit_test",
    ],
    visibility = ["//js/private/tools:__pkg__"],
)
