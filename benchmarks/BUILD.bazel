load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "benchmark",
    srcs = [
        "inventory.go",
        "main.go",
        "metrics.go",
        "statistics.go",
    ],
    embedsrcs = glob(["fixtures/**"]),
    pure = "on",
    visibility = ["//visibility:public"],
    deps = ["@com_github_latticebuild_graceproc//:graceproc"],
)

go_test(
    name = "unit_test",
    srcs = [
        "benchmark_test.go",
        "inventory.go",
        "main.go",
        "metrics.go",
        "statistics.go",
    ],
    embedsrcs = glob(["fixtures/**"]),
    pure = "on",
    deps = ["@com_github_latticebuild_graceproc//:graceproc"],
)

go_test(
    name = "unit_race_test",
    srcs = [
        "benchmark_test.go",
        "inventory.go",
        "main.go",
        "metrics.go",
        "statistics.go",
    ],
    embedsrcs = glob(["fixtures/**"]),
    pure = "off",
    race = "on",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["@com_github_latticebuild_graceproc//:graceproc"],
)
