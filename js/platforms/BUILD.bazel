"""The platforms npm installs packages for, in npm's spellings.

pnpm installs every platform's native packages that pnpm-workspace.yaml's
supportedArchitectures names, and the pnpm repository rule renders an edge to a package
npm installs only on some platforms as a select over these settings. A tool
then resolves its native packages for the execution platform and a tree for
the target platform, and no action receives another platform's binaries. At
most one setting matches a platform; one that matches none (an operating
system npm has no name for here) gets no such package, as npm would install
none.

libc is //tools/bazel/platforms:libc, which a platform that names none has as
glibc; npm does not check it off Linux.
"""

package(default_visibility = ["//visibility:private"])

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "darwin_x64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "win32_arm64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:arm64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "win32_x64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_arm64_glibc",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        "//js/platforms:glibc",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_arm64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        "//js/platforms:musl",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_x64_glibc",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//js/platforms:glibc",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_x64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//js/platforms:musl",
    ],
    visibility = ["//visibility:public"],
)

constraint_setting(
    name = "libc",
    default_constraint_value = ":glibc",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)
