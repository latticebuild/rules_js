load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "write-svelte-kit",
    srcs = [
        "main.go",
        "write.go",
    ],
    pure = "on",
    target_compatible_with = [],
    visibility = ["//:__subpackages__"],
    deps = ["//go/filetree:lib"],
)

go_test(
    name = "unit_test",
    srcs = [
        "main.go",
        "main_test.go",
        "write.go",
        "write_test.go",
    ],
    pure = "on",
    race = "off",
    target_compatible_with = [],
    deps = ["//go/filetree:lib"],
)

go_test(
    name = "unit_race_test",
    srcs = [
        "main.go",
        "main_test.go",
        "write.go",
        "write_test.go",
    ],
    pure = "off",
    race = "on",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//go/filetree:lib"],
)

test_suite(
    name = "runtime_test",
    tests = [
        ":unit_race_test",
        ":unit_test",
    ],
    visibility = ["//:__subpackages__"],
)
