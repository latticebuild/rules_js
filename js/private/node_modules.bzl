"""Expose pnpm's existing installation directly as a Bazel repository."""

load("//js/private/pnpm:discovery.bzl", "discover", "inventory")
load("//js/private/pnpm:graph.bzl", "resolve_graph")
load("//js/private/pnpm:packages.bzl", "describe_packages", "package_label")
load("//js/private/pnpm:render.bzl", "package_build", "workspace_index")

visibility("//...")

def _node_modules_impl(ctx):
    root = ctx.path(ctx.attr.package_json).dirname.realpath
    modules, budget, workspace = discover(ctx, root)
    describe_packages(ctx, root, modules, budget, ctx.read(ctx.attr._spdx).splitlines())
    for diagnostic in resolve_graph(modules):
        ctx.report_progress(diagnostic)
    files = inventory(ctx, root, modules, budget)
    builds = {module["rel"] + "/BUILD.bazel": package_build(module) for module in modules if not module["workspace"]}
    _validate_destinations(builds, files)
    index = workspace_index(modules, ctx.original_name, workspace)
    exports = ["workspace.json"]
    if index["workspace"]["source"]:
        exports.append("pnpm-workspace.yaml")
        ctx.file("pnpm-workspace.yaml", index["workspace"]["source"], executable = False)

    # Real repository directories prevent BUILD writes through source symlinks.
    ctx.file("REPO.bazel", "", executable = False)
    ctx.file("BUILD.bazel", _ROOT_BUILD.format(
        exports = repr(exports),
        metadata = repr([package_label(module["rel"], module["metadata"]) for module in modules if not module["workspace"]]),
    ), executable = False)
    ctx.file("workspace.json", json.encode_indent(index) + "\n", executable = False)
    for path, contents in builds.items():
        ctx.file(path, contents, executable = False)
    ctx.file("node_modules/BUILD.bazel", "filegroup(name = \"modules\", srcs = %r)\n" % [module["label"] for module in modules if not module["workspace"]], executable = False)
    for path, source in files.items():
        # Windows may copy leaves instead of creating native symlinks.
        if ctx.os.name.lower().startswith("windows"):
            ctx.watch(source)
        ctx.symlink(source, path)

node_modules = repository_rule(
    implementation = _node_modules_impl,
    doc = "Expose an installed workspace from an existing installation, without a setup generator.",
    local = True,
    attrs = {
        "package_json": attr.label(
            mandatory = True,
            allow_single_file = True,
            doc = "The main workspace's root package.json, beside its installed node_modules.",
        ),
        "_spdx": attr.label(
            default = Label("//js/private/pnpm:generated/spdx_ids.txt"),
            allow_single_file = True,
        ),
        "_yq_binaries": attr.label_keyed_string_dict(
            default = {
                Label("@yq_" + platform + "//:yq" + (".exe" if platform.startswith("windows_") else "")): platform
                for platform in [
                    "darwin_amd64",
                    "darwin_arm64",
                    "linux_amd64",
                    "linux_arm64",
                    "linux_ppc64le",
                    "linux_riscv64",
                    "linux_s390x",
                    "windows_amd64",
                    "windows_arm64",
                ]
            },
            allow_files = True,
        ),
    },
)

_ROOT_BUILD = """\
exports_files({exports}, visibility = ["//visibility:public"])

# Every installed package's package_metadata, for supply-chain checks. A
# filegroup forwards no providers, so consumers walk its srcs with an aspect.
filegroup(
    name = "package_metadata",
    srcs = {metadata},
    visibility = ["//visibility:public"],
)
"""

def _validate_destinations(builds, files):
    if len(builds) + len(files) > 1000000:
        fail("pnpm repository exceeds 1000000 entries")
    destinations = sorted([path + "/" for path in builds.keys() + files.keys()])
    for previous, current in zip(destinations, destinations[1:]):
        if current.startswith(previous):
            fail("Overlapping pnpm repository destinations: %s and %s" % (previous, current))
